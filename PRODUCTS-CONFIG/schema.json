{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "number"
    },
    "products": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "enum": [
              "landing",
              "portfolio",
              "corporate",
              "media",
              "directory",
              "booking",
              "qr-menu",
              "store",
              "learning",
              "tours",
              "delivery",
              "marketplace",
              "saas",
              "crm",
              "attestation",
              "scheduler",
              "ai-coach",
              "agents",
              "competitors",
              "company-brain",
              "business-brain",
              "custom"
            ]
          },
          "surface": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "headless"
            ]
          },
          "route": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "building",
              "live"
            ]
          },
          "createdAt": {
            "type": "string"
          },
          "titleAuto": {
            "type": "boolean"
          },
          "description": {
            "type": "string"
          },
          "devStatus": {
            "type": "string",
            "enum": [
              "not-started",
              "decomposition",
              "skeleton",
              "revision",
              "building",
              "acceptance",
              "extra-tasks",
              "done"
            ]
          },
          "steps": {
            "type": "array",
            "items": {
              "type": "number"
            }
          }
        },
        "required": [
          "id",
          "title",
          "type",
          "surface",
          "route",
          "status",
          "createdAt"
        ],
        "additionalProperties": {}
      }
    },
    "maxId": {
      "type": "number"
    }
  },
  "required": [
    "version",
    "products"
  ],
  "additionalProperties": {}
}
